{
  "errors": {
    "change-floor": {
      "raisedBy": [
        "yed_send",
        "yed_sendmany",
        "yed_redeem",
        "yed_claim"
      ],
      "when": "YED change would lie in (0, MIN_OUTPUT) (§4.6); the message names the nearest workable amounts (structured by H2 in Phase 8)"
    },
    "claim-not-underwater": {
      "raisedBy": [
        "yed_claim"
      ],
      "when": "RED-4 would fail at the reference snapshot"
    },
    "claim-not-yet": {
      "raisedBy": [
        "yed_claim"
      ],
      "when": "tip below claimHeight"
    },
    "fee-no-eligible-payee": {
      "raisedBy": [
        "yed_getfeepayee"
      ],
      "when": "E(R) empty (FEE-0; not an error for the wallet, which omits the output)"
    },
    "insufficient-yed": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_send"
      ],
      "when": "wallet YED below the burn or amount"
    },
    "mempool-check-failed:<verdict>": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim"
      ],
      "when": "MempoolCheck returned the named RED verdict (K7)"
    },
    "mint-bad-lock": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "lockBlocks outside every class or lockHeight + GRACE ≥ LOCKTIME_THRESHOLD"
    },
    "mint-unsatisfiable": {
      "raisedBy": [
        "yed_mint",
        "yed_estimatecollateral"
      ],
      "when": "requiredZat > MAX_MONEY (K14)"
    },
    "mintpol-cap": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap"
    },
    "mintpol-divergence": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap"
    },
    "mintpol-global-ratio": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap"
    },
    "mintpol-no-price": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap"
    },
    "mintpol-not-active": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap"
    },
    "mintpol-participation": {
      "raisedBy": [
        "yed_mint"
      ],
      "when": "MINTPOL-1, one per halt bit and the cap"
    },
    "no-payout-address": {
      "raisedBy": [
        "yed_setquote"
      ],
      "when": "the node has no payout key and so can emit no tag"
    },
    "not-a-yellowback-address": {
      "raisedBy": [
        "yed_send",
        "yed_sendmany",
        "yed_validateaddress"
      ],
      "when": "the recipient is not a ye…/yt…/yr… address of this network"
    },
    "quote-out-of-range": {
      "raisedBy": [
        "yed_setquote"
      ],
      "when": "price outside [PRICE_MIN, PRICE_MAX] and not 0"
    },
    "sweep-acknowledgement-missing": {
      "raisedBy": [
        "yed_sweep"
      ],
      "when": "the second argument is not the exact acknowledgement string"
    },
    "sweep-not-abandoned": {
      "raisedBy": [
        "yed_sweep"
      ],
      "when": "the abandonment predicate (§4.6) is false: enforcement is on, or suspended for less than ABANDON_BLOCKS (L10, L12 — a passed sunset alone is not abandonment)"
    },
    "vault-locked": {
      "raisedBy": [
        "yed_redeem"
      ],
      "when": "tip below lockHeight (ACTIVE and VOID alike)"
    },
    "vault-not-active": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_getvault"
      ],
      "when": "as named; vault-not-active means CLOSED or CLAIMED — a VOID vault is releasable by yed_redeem (L14)"
    },
    "vault-not-found": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_getvault"
      ],
      "when": "as named; vault-not-active means CLOSED or CLAIMED — a VOID vault is releasable by yed_redeem (L14)"
    },
    "vault-not-owned": {
      "raisedBy": [
        "yed_redeem",
        "yed_claim",
        "yed_getvault"
      ],
      "when": "as named; vault-not-active means CLOSED or CLAIMED — a VOID vault is releasable by yed_redeem (L14)"
    },
    "verdict-parent-not-tip": {
      "raisedBy": [
        "yed_getblockverdict"
      ],
      "when": "the block's parent is not the index tip and the block is not a rejected child of it (N12)"
    },
    "yellowback-unhealthy": {
      "raisedBy": [
        "every gated command"
      ],
      "when": "the index is unhealthy (unhealthyReason follows)"
    }
  },

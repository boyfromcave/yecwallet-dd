        <item row="0" column="0"><widget class="QLabel" name="s1"><property name="text"><string>YEC price (median of pool quotes)</string></property></widget></item>
        <item row="0" column="1"><widget class="QLabel" name="lblYecPrice"><property name="text"><string>-</string></property><property name="toolTip"><string>P_mid: the median of the price quotes pools published in their own blocks over the middle window. Prices are undefined until enough blocks carry quotes.</string></property></widget></item>
        <item row="1" column="0"><widget class="QLabel" name="s2"><property name="text"><string>Mint price / claim price</string></property></widget></item>
        <item row="1" column="1"><widget class="QLabel" name="lblMintClaimPrice"><property name="text"><string>-</string></property><property name="toolTip"><string>P_mint (the lowest of the three medians) sets the collateral a mint needs; P_claim (the higher of the middle and slow medians) decides when a vault is underwater. Either is undefined when its windows hold too few quotes.</string></property></widget></item>
        <item row="2" column="0"><widget class="QLabel" name="s3"><property name="text"><string>Volatility multiplier (σ)</string></property></widget></item>
        <item row="2" column="1"><widget class="QLabel" name="lblSigma"><property name="text"><string>-</string></property><property name="toolTip"><string>Scales every class's base collateral ratio with recent price volatility.</string></property></widget></item>

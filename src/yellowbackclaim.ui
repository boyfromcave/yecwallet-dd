<ui version="4.0">
 <class>YellowbackClaim</class>
 <widget class="QWidget" name="YellowbackClaim">
  <layout class="QVBoxLayout" name="claimLayout">
   <item>
    <widget class="QLabel" name="lblClaimIntro">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Vaults past their claim height whose collateral is worth less than their debt at the claim price. Anyone may claim one by burning its debt in YED from their own balance; the fees are paid from the claimant's own YEC. A claim moves the collateral (less the owner's residual) into a claim intent: after the claim delay the claimant releases it on the Pending claims page, and until then any member of the attestor set may cancel a claim made at a wrong price, in which case the burn is lost. Every full node checks these rules; the claim path needs nobody's key.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QTableView" name="tblClaimable">
     <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
     <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lblClaimHint">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string/></property>
     <property name="styleSheet"><string notr="true">QLabel { color: #444; }</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="claimButtons">
     <item><spacer name="claimSpacerH"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
     <item><widget class="QPushButton" name="btnClaim"><property name="text"><string>Claim selected vault…</string></property></widget></item>
    </layout>
   </item>
  </layout>
 </widget>

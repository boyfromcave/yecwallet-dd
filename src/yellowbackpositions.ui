<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>YellowbackPositions</class>
 <widget class="QWidget" name="YellowbackPositions">
  <layout class="QVBoxLayout" name="positionsLayout">
   <item>
    <widget class="QLabel" name="lblPositionsIntro">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>One row per vault you own. Redeeming an ACTIVE vault at or past its lock height burns exactly the YED it minted and pays an enforcement fee to a quoting pool; Renew redeems it and mints the same YED again in a new vault. "Claimable" means the vault is past its claim height and underwater, so anyone may burn its debt and claim the collateral; a CLAIMING vault is under such a claim, which is released to the claimant after the claim delay unless a member of the attestor set cancels it. A VOID vault (recorded before the vault upgrade) created no YED: release its collateral with no burn and no fee.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="positionsFilterRow">
     <item><widget class="QLabel" name="lblPositionsFilter"><property name="text"><string>Show</string></property></widget></item>
     <item><widget class="QComboBox" name="cmbPositionsFilter"><property name="toolTip"><string>Which vaults to list. "Open" is the ones you can still act on: ACTIVE and VOID.</string></property></widget></item>
     <item><spacer name="posFilterSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
    </layout>
   </item>
   <item>
    <widget class="QTableView" name="tblPositions">
     <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
     <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="lblVaultAction">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string/></property>
     <property name="styleSheet"><string notr="true">QLabel { color: #444; }</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="positionsButtons">
     <item><widget class="QPushButton" name="btnWhyVoid"><property name="text"><string>Why is this vault VOID?</string></property></widget></item>
     <item><spacer name="posSpacerH"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
     <item><widget class="QPushButton" name="btnRelease"><property name="text"><string>Release…</string></property></widget></item>
     <item><widget class="QPushButton" name="btnRedeem"><property name="text"><string>Redeem…</string></property></widget></item>
     <item><widget class="QPushButton" name="btnRenew"><property name="text"><string>Renew…</string></property></widget></item>
     <item><widget class="QPushButton" name="btnNotice"><property name="text"><string>Post claim notice…</string></property></widget></item>
    </layout>
   </item>
  </layout>
 </widget>
